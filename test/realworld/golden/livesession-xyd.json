{
  "asyncapi": "3.1.0",
  "info": {
    "title": "Generated API",
    "version": "1.0.0"
  },
  "channels": {},
  "components": {
    "schemas": {
      "ApiVersion": {
        "properties": {
          "version": {
            "type": "string"
          },
          "specUrl": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "version",
          "specUrl",
          "updatedAt",
          "current"
        ]
      },
      "DistTag": {
        "properties": {
          "tag": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "tag",
          "version"
        ],
        "description": "A named, movable pointer to a version (npm-style). `latest` is auto-managed\n(set to the newest version on register); others (`canary`, `beta`, …) are set\nby hand. A version ref anywhere may be a concrete version OR a dist-tag name."
      },
      "RegistryEntryCore": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "format": {
            "$ref": "#/components/schemas/ApiFormat"
          },
          "kind": {
            "$ref": "#/components/schemas/EntryKind",
            "description": "`api` (OpenAPI/GraphQL/AsyncAPI) or `schema` (standalone JSON Schema)."
          },
          "ns": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/ApiVersion"
            },
            "type": "array"
          },
          "distTags": {
            "items": {
              "$ref": "#/components/schemas/DistTag"
            },
            "type": "array",
            "description": "dist-tags for this API (always includes `latest`)."
          },
          "registryUrl": {
            "type": "string",
            "description": "Canonical resolvable URL served by registry-api: `/@{ns}/apis/{id}@latest`."
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "format",
          "kind",
          "ns",
          "source",
          "versions",
          "distTags",
          "registryUrl",
          "updatedAt"
        ],
        "description": "Registry-api's shape: the core registered API, without platform rollups."
      },
      "RegistryEntry": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "format": {
            "$ref": "#/components/schemas/ApiFormat"
          },
          "kind": {
            "$ref": "#/components/schemas/EntryKind",
