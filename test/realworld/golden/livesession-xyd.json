        "type": "object"
      },
      "RegisterInput": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ]
      },
      "LoginInput": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ]
      },
      "CreateProjectInput": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      },
      "ApiKey": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "description": "Public prefix shown in the list to tell keys apart (e.g. `atk_live_a1b2`)."
          },
          "createdAt": {
            "type": "string"
          },
          "lastUsedAt": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix",
          "createdAt"
        ],
        "description": "A workspace API key. Only its SHA-256 hash is stored; the secret is returned\nonce, at creation (see CreatedApiKey)."
      },
      "CreateApiKeyInput": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      },
      "CreatedApiKey": {
        "properties": {
          "key": {
            "$ref": "#/components/schemas/ApiKey"
          },
          "secret": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "key",
          "secret"
        ],
        "description": "The created key plus its plaintext secret — the ONLY time the secret is\nreturned. Store it now; it can't be retrieved again."
      },
      "UpdateProjectInput": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      },
      "SelectProjectInput": {
        "properties": {
          "projectId": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
