          },
          "registryUrl": {
            "type": "string",
            "description": "Canonical resolvable URL served by registry-api: `/@{ns}/apis/{id}@latest`."
          },
          "updatedAt": {
            "type": "string"
          },
          "sdkTargetCount": {
            "format": "int32",
            "type": "integer"
          },
          "docsProjectCount": {
            "format": "int32",
            "type": "integer"
          },
          "mcpServerCount": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "format",
          "kind",
          "ns",
          "source",
          "versions",
          "distTags",
          "registryUrl",
          "updatedAt",
          "sdkTargetCount",
          "docsProjectCount",
          "mcpServerCount"
        ],
        "description": "The gateway shape the frontend consumes: core + cross-section rollups."
      },
      "Sdk": {
        "properties": {
          "id": {
            "type": "string"
          },
          "apiId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ns": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "registryRef": {
            "type": "string"
          },
          "targetCount": {
            "format": "int32",
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "id",
          "apiId",
          "name",
          "description",
          "ns",
          "version",
          "registryRef",
          "targetCount",
          "createdAt",
          "updatedAt"
        ],
        "description": "A named SDK project tied to one API — a collection of per-language targets."
      },
      "SdkTarget": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Human display title, fixed at creation (\"<API title> <language>\", e.g.\n\"LiveSession OpenAPI Python\") — decoupled from the slug `id` and the\npublished package name."
          },
          "sdkId": {
            "type": "string",
            "description": "The parent SDK this target belongs to."
          },
          "apiId": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string",
            "description": "The API spec version this target was last built from — decoupled from the\ntarget's own package `version`."
          },
          "language": {
            "$ref": "#/components/schemas/SdkLanguage"
          },
          "packageName": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BuildStatus"
          },
          "buildLogs": {
            "type": "string",
            "description": "The target's own generation log (`[<lang>] …` lines) — reset each build and\nappended live, so the dashboard can tail the current (re)generation."
          },
          "lastPublishedAt": {
            "type": "string"
          },
          "registryUrl": {
            "type": "string"
          },
          "sdkJson": {
            "type": "string",
            "description": "The custom sdk.json applied at generation (the \"wizard\" config), serialized;\nempty when the target used the auto-derived config."
          },
          "configPending": {
            "type": "boolean",
            "description": "The saved sdk.json config has UNBUILT changes — set when the config is edited\n(the wizard \"Save\"), cleared when a build applies it. Drives the persistent\n\"pending changes, waiting for a build\" status in the UI."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "sdkId",
          "apiId",
          "apiVersion",
          "language",
          "packageName",
          "output",
          "version",
          "status",
          "buildLogs",
          "configPending"
        ]
      },
      "SdkBuild": {
        "properties": {
          "id": {
            "type": "string"
          },
          "sdkId": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "The SDK version this build produced."
          },
          "apiVersion": {
            "type": "string",
            "description": "The API spec version every target was built from."
          },
          "status": {
            "type": "string",
            "description": "building | ready | error"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/SdkBuildTarget"
            },
            "type": "array",
            "description": "Point-in-time snapshot of the targets that went into the build."
          },
          "logs": {
            "type": "string",
            "description": "Accumulated build log — step lines from each target generation."
          },
          "createdAt": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sdkId",
          "version",
          "apiVersion",
          "status",
          "targets",
          "logs",
          "createdAt"
        ],
        "description": "One SDK build — a produced SDK version, kept as history (the Versions tab).\nRegenerates every target from one API spec version; decoupled from each\ntarget's published package version."
      },
