      "UpdateApiInput": {
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "type": "object",
        "description": "Editable presentation metadata for an existing registry entry. The id/slug,\nnamespace, format, and kind are IMMUTABLE — they're baked into URLs, the\n`apis/<ns>/<api>@<ver>` registry refs, and already-generated SDKs — so only\nthe display name + description can change (a partial update; omit to keep)."
      },
      "RegisterApiInput": {
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Explicit id/slug for the entry. Slugified server-side; defaults to a slug\nof `name`. Lets the display title (`name`) be decoupled from the stable id."
          },
          "format": {
            "$ref": "#/components/schemas/ApiFormat"
          },
          "kind": {
            "$ref": "#/components/schemas/EntryKind",
            "description": "`api` (default) or `schema` — classifies the uploaded document."
          },
          "ns": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "specText": {
            "type": "string",
            "description": "Inline spec text (yaml/json/graphql SDL). One of specText | url required."
          },
          "url": {
            "type": "string",
            "description": "URL to fetch the spec from (server-side)."
          },
          "version": {
            "type": "string",
            "description": "Explicit version label; defaults to the spec's info.version."
          },
          "distTag": {
            "type": "string",
            "description": "Dist-tag to publish this version under (default `latest`). `latest` makes\nit the current/default version; any other tag (`canary`, `beta`, …) is a\nside-channel — added without moving `latest`/current off the stable one."
          },
          "projectId": {
            "type": "string",
            "description": "The project the API belongs to. Set server-side by the platform gateway\nfrom the caller's current project; defaults to the seeded project."
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      },
      "SetDistTagInput": {
        "properties": {
          "tag": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "tag",
          "version"
        ],
        "description": "Set (create or move) a dist-tag to point at an existing version."
      },
      "CreateSdkInput": {
        "properties": {
          "apiId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Explicit id/slug for the SDK. Slugified server-side; defaults to a slug of\n`name`. Lets the display title (`name`) be decoupled from the stable id."
          },
          "description": {
            "type": "string"
          },
          "ns": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "apiId"
        ],
        "description": "Create a named SDK for an API."
      },
      "AddSdkTargetInput": {
        "properties": {
          "language": {
            "$ref": "#/components/schemas/SdkLanguage"
          },
          "packageName": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "API version to generate from; defaults to the API's current version."
          },
          "sdkJson": {
            "type": "string",
            "description": "A full custom sdk.json (behavior + per-language emitter options), serialized.\nWhen set it's applied over the derived defaults during generation (the\n\"wizard\" flow); empty → the auto-derived config."
          }
        },
        "type": "object",
        "required": [
          "language"
        ],
        "description": "Add a language target to an SDK (kicks off generation)."
      },
      "BuildSdkInput": {
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "API version to build every target from; defaults to the API's current."
          }
        },
        "type": "object",
        "description": "Rebuild every target of an SDK from one API spec version."
      },
      "CreateSdkVersionInput": {
        "properties": {
          "version": {
            "type": "string",
            "description": "The new SDK version (e.g. \"0.2.0\")."
          },
          "apiVersion": {
            "type": "string",
            "description": "API version to build from; defaults to the API's current."
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "description": "Create a new SDK version: bump the SDK's version and rebuild every target\nfrom one API spec version, recorded as a build in the history."
      },
      "CreateDocsProjectInput": {
        "properties": {
          "apiId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "apiId",
          "name"
        ]
      },
      "CreateMcpServerInput": {
        "properties": {
          "apiId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "transport": {
            "$ref": "#/components/schemas/McpTransport"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "apiId",
          "name"
        ]
      },
      "MarkReadInput": {
        "properties": {
          "ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
