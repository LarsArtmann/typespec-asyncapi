            "type": "string",
            "description": "Registry URL, or a local file-feed path."
          },
          "token": {
            "type": "string",
            "description": "Auth token; may be empty for an anonymous/local registry."
          }
        },
        "type": "object",
        "required": [
          "kind",
          "url"
        ],
        "description": "Connect a package registry account."
      },
      "CreateRegistryConnectionInput": {
        "properties": {
          "registryId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "packageName": {
            "type": "string",
            "description": "Override the published package name (defaults to the SDK's own name)."
          },
          "autoPublish": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "registryId",
          "targetId"
        ],
        "description": "Link an SDK target to a package registry."
      },
      "PrepareReleaseInput": {
        "properties": {
          "connectionId": {
            "type": "string"
          },
          "versionOverride": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "connectionId"
        ]
      },
      "SetReleaseConfigInput": {
        "properties": {
          "releaseMode": {
            "type": "string"
          },
          "autoRelease": {
            "type": "boolean"
          },
          "baseBranch": {
            "type": "string"
          },
          "prerelease": {
            "type": "boolean"
          },
          "distTags": {
            "type": "string",
            "description": "Comma-separated dist-tags this connection reacts to (default `latest`);\n`*` = all. Only a version published under a matching tag triggers a\nrelease."
          }
        },
        "type": "object",
        "required": [
          "releaseMode",
          "autoRelease"
        ]
      },
      "ApiFormat": {
        "enum": [
          "openapi",
          "graphql",
          "asyncapi",
          "jsonschema"
        ],
        "type": "string"
      },
      "EntryKind": {
        "enum": [
          "api",
          "schema"
        ],
        "type": "string",
        "description": "What kind of document a registry entry holds: a full API spec or a schema."
      },
      "BuildStatus": {
        "enum": [
          "ready",
          "building",
          "error",
          "draft"
        ],
        "type": "string"
      },
      "SdkLanguage": {
        "enum": [
          "go",
          "python",
          "node",
          "ruby",
          "java",
          "dotnet"
        ],
        "type": "string"
      },
      "McpTransport": {
        "enum": [
          "http",
          "sse",
          "stdio"
        ],
        "type": "string"
      },
      "NotificationSeverity": {
        "enum": [
          "info",
          "success",
          "warning",
          "error"
        ],
        "type": "string"
      },
      "NotificationSource": {
        "enum": [
          "sdk",
          "docs",
          "mcp",
          "registry",
          "system",
          "git"
        ],
        "type": "string"
      },
      "GitProviderKind": {
        "enum": [
          "github",
          "gitlab",
          "bitbucket",
          "gitea"
        ],
        "type": "string",
        "description": "The git platforms the gitprovider service can connect to."
      },
      "RepoTargetKind": {
        "enum": [
          "spec",
          "sdk"
        ],
        "type": "string",
        "description": "What a repo connection syncs into a repo."
      },
      "UsageRange": {
        "enum": [
          "24h",
          "7d",
          "30d",
          "90d"
        ],
        "type": "string"
      },
      "PackageRegistryKind": {
        "enum": [
          "npm",
          "pypi",
          "gems",
          "maven",
          "nuget",
          "goproxy"
        ],
        "type": "string",
        "description": "Package registry flavour — the language ecosystem an SDK publishes into."
      },
      "ReleaseState": {
        "enum": [
          "preparing",
          "pr_open",
          "merging",
          "released",
          "failed",
          "superseded"
        ],
        "type": "string",
        "description": "A versioned release cycle for an SDK connection (the rolling PR + its state)."
      }
    }
  }
}