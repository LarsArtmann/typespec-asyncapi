        ]
      },
      "InviteMemberInput": {
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "email"
        ]
      },
      "UpdateMemberRoleInput": {
        "properties": {
          "role": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "role"
        ]
      },
      "ConnectGitProviderInput": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/GitProviderKind"
          },
          "name": {
            "type": "string"
          },
