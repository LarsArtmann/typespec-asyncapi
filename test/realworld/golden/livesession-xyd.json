            "type": "string",
            "description": "Provider base URL; optional for github.com/gitlab.com, required for self-hosted."
          },
          "token": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "token"
        ],
        "description": "Connect a git provider (validated via the provider's whoami)."
      },
      "CreateRepoConnectionInput": {
        "properties": {
          "providerId": {
            "type": "string"
          },
          "targetKind": {
            "$ref": "#/components/schemas/RepoTargetKind"
          },
          "targetId": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "description": "For an existing repo: \"owner/name\". For a new repo: just the name."
          },
          "createRepo": {
            "type": "boolean",
            "description": "When true, create `repo` (a name) under the account before connecting."
          },
          "makePrivate": {
            "type": "boolean",
            "description": "Visibility for a newly-created repo."
          },
          "branch": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "releaseMode": {
            "type": "string"
          },
          "autoRelease": {
            "type": "boolean"
          },
          "baseBranch": {
            "type": "string"
          },
          "distTags": {
            "type": "string",
            "description": "Comma-separated dist-tags to react to (default `latest`; `*` = all)."
          }
        },
        "type": "object",
        "required": [
          "providerId",
          "targetKind",
          "targetId",
          "repo"
        ],
        "description": "Link an API spec or SDK target to a repo."
      },
      "ConnectRegistryInput": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/PackageRegistryKind"
          },
          "name": {
            "type": "string"
          },
