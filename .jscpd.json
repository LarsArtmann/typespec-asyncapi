{
  "threshold": 0,
  "format": ["typescript", "javascript"],
  "output": "./jscpd-report",
  "reporters": ["html", "json", "console", "markdown"],
  "min-lines": 5,
  "min-tokens": 50,
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/tsp-output/**",
    "**/test-output/**",
    "**/jscpd-report/**",
    "**/*.d.ts",
    "src/constants/generated-bindings.ts",
    "**/*.config.js",
    "**/*.config.ts",
    "**/docs/**",
    "**/examples/**"
  ]
}
