    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "html-validate": "^11.5.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "devalue": "5.8.1",
    "yaml": "2.8.3"
  },
