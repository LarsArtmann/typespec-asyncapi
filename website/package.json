{
  "name": "typespec-asyncapi-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and documentation for typespec-asyncapi — generate validated AsyncAPI 3.1 specifications from TypeSpec",
  "keywords": [
    "asyncapi",
    "astro",
    "documentation",
    "event-driven",
    "kafka",
    "mqtt",
    "schema-generation",
    "starlight",
    "typespec",
    "websockets"
  ],
  "homepage": "https://typespec-asyncapi.lars.software",
  "bugs": "https://github.com/LarsArtmann/typespec-asyncapi/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/LarsArtmann/typespec-asyncapi.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-stats.mjs && node scripts/build-playground.mjs && astro dev",
    "stats": "node scripts/sync-stats.mjs",
    "build": "node scripts/sync-stats.mjs && node scripts/build-playground.mjs && astro build && node scripts/fix-csp.mjs",
    "preview": "astro preview",
    "brand:png": "node scripts/render-brand-png.mjs",
    "typecheck": "astro check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run check:html && pnpm run check:links && pnpm run check:csp",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "astro": "astro",
    "playground": "node scripts/build-playground.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "astro-og-canvas": "^0.13.3",
    "canvaskit-wasm": "^0.42.0",
    "starlight-llms-txt": "^0.12.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "html-validate": "^11.18.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "esbuild": "^0.28.2",
    "@typespec/compiler": "^1.17.0"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "devalue": "5.8.1",
    "yaml": "2.8.3"
  }
}
