---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/config';
import { stats } from '../data/stats';

export interface Props {
  title: string;
  canonicalPath?: string;
  robots?: string;
  extraHead?: string;
}

const { title, canonicalPath = "/", robots = "index, follow, max-image-preview:large, max-snippet:-1", extraHead } = Astro.props;
const ogDesc = siteConfig.ogDescription;
const canonical = `${siteConfig.siteUrl}${canonicalPath}`;
const ogImage = `${siteConfig.siteUrl}/og.png`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical}#website`,
      "url": canonical,
      "name": siteConfig.name,
      "description": siteConfig.description,
      "inLanguage": "en",
      "publisher": { "@id": `${canonical}#author` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteConfig.siteUrl}/search/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#software`,
      "name": siteConfig.name,
      "description": siteConfig.description,
      "url": canonical,
      "softwareVersion": stats.version,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Node.js",
      "programmingLanguage": ["TypeScript"],
      "runtimePlatform": "Node.js 20.11+",
      "codeRepository": siteConfig.github,
      "downloadUrl": siteConfig.npm,
      "license": "https://opensource.org/licenses/MIT",
      "author": { "@id": `${canonical}#author` },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Person",
      "@id": `${canonical}#author`,
      "name": siteConfig.author.name,
      "url": siteConfig.author.url,
      "sameAs": [siteConfig.github]
    }
  ]
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline src="/js/theme-init.js"></script>
    <title>{title}</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.author.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM documentation index" />
    <link rel="search" type="application/opensearchdescription+xml" href="/opensearch.xml" title="Search typespec-asyncapi" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="typespec-asyncapi releases" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={siteConfig.title} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="typespec-asyncapi — TypeSpec in, validated AsyncAPI 3.1 out" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.social.twitter} />
    <meta name="twitter:creator" content={siteConfig.social.twitter} />
    <meta name="twitter:title" content={siteConfig.title} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="typespec-asyncapi — TypeSpec in, validated AsyncAPI 3.1 out" />

    <meta name="theme-color" content="#0a0908" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    {extraHead && <Fragment set:html={extraHead} />}
  </head>
  <body class="font-sans bg-bg-primary text-text-secondary antialiased leading-relaxed">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-on-accent focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">Skip to content</a>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/js/animations.js" defer></script>
  </body>
</html>
