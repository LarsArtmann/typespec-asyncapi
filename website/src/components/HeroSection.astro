---
import { siteConfig } from '../data/config';
import { stats } from '../data/stats';
import Icon from './Icon.astro';
import LockupHorizontal from './LockupHorizontal.astro';

async function getGitHubStars(): Promise<number | null> {
  try {
    const response = await fetch('https://api.github.com/repos/LarsArtmann/typespec-asyncapi', {
      headers: {
        'Accept': 'application/vnd.github.v3+json',
      },
    });
    if (!response.ok) return null;
    const data = await response.json();
    return data.stargazers_count as number;
  } catch {
    return null;
  }
}

const stars = await getGitHubStars();
const starsText = stars === null ? 'Star on GitHub' : `${stars} stars`;

const k = (text: string) => `<span class="text-accent-light">${text}</span>`;
const s = (text: string) => `<span class="text-amber">${text}</span>`;
const t = (text: string) => `<span class="text-accent">${text}</span>`;
const d = (text: string) => `<span class="text-text-muted">${text}</span>`;
const p = (text: string) => `<span class="text-text-secondary">${text}</span>`;

const inputCode = `${k('import')} ${s('"@lars-artmann/typespec-asyncapi"')};
${k('using')} ${t('TypeSpec.AsyncAPI')};

${d('@service')}(${d('#{')} ${p('title:')} ${s('"Orders"')} ${d('}')})
${k('namespace')} ${t('Orders')};

${k('model')} ${t('OrderPlaced')} ${p('{')}
  ${p('orderId:')} ${t('string')};
  ${p('total:')} ${t('decimal')};
  ${p('placedAt:')} ${t('utcDateTime')};
${p('}')}

${d('@channel')}(${s('"orders.placed"')})
${d('@publish')}
${d('@protocol')}(${d('#{')} ${p('protocol:')} ${s('"kafka"')}, ${p('topic:')} ${s('"orders.placed"')} ${d('}')})
${k('op')} ${k('publishOrderPlaced')}(): ${t('OrderPlaced')};`;

const outputCode = `${p('asyncapi:')} ${s('3.1.0')}
${p('info:')}
  ${p('title:')} ${s('Orders')}
  ${p('version:')} ${s('1.0.0')}
${p('channels:')}
  ${t('orders.placed:')}
    ${p('address:')} ${s('orders.placed')}
    ${p('bindings:')}
      ${t('kafka:')}
        ${p('topic:')} ${s('orders.placed')}
        ${p('partitions:')} ${s('6')}
        ${p('bindingVersion:')} ${s('0.5.0')}
${p('operations:')}
  ${t('publishOrderPlaced:')}
    ${p('action:')} ${s('send')}
    ${p('channel:')}
      ${p('$ref:')} ${s('"#/channels/orders.placed"')}
${p('components:')}
  ${p('messages:')} ${d('…')}
  ${p('schemas:')} ${d('…')}`;

const installCommand = 'pnpm add @lars-artmann/typespec-asyncapi';

const statLine = [
  `${stats.protocols} protocols`,
  `${stats.bindings} bindings`,
  `${stats.decorators} decorators`,
  `${stats.diagnostics} diagnostics`,
  `${stats.complianceTests} compliance tests`,
];
---

<section class="relative flex items-center justify-center overflow-hidden pt-20 pb-12">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-accent/8 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 -left-20 w-[420px] h-[420px] bg-accent/8 blur-[130px] rounded-full pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-6 text-center">
    <LockupHorizontal height={52} class="mx-auto mb-5 text-text-primary" id="hero" />

    <div class="flex items-center justify-center gap-2.5 mb-5 flex-wrap">
      <a class="inline-flex items-center gap-1.5 px-3.5 py-1.5 border border-border rounded-md text-text-secondary text-sm font-medium no-underline hover:border-accent hover:text-accent transition-all duration-150" href={siteConfig.github} target="_blank" rel="noopener">
        <Icon name="star" size={14} />
        {starsText}
      </a>
      <a class="inline-flex items-center gap-1.5 px-3.5 py-1.5 border border-border rounded-md text-text-secondary text-sm font-medium no-underline hover:border-accent hover:text-accent transition-all duration-150" href={siteConfig.npm} target="_blank" rel="noopener">
        v{stats.version} on npm
      </a>
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-accent-text text-sm font-medium bg-accent/10">
        <Icon name="check" size={14} />
        AsyncAPI 3.1.0 &middot; AJV-validated
      </span>
    </div>

    <h1 class="text-[clamp(2.25rem,5.5vw,3.6rem)] font-bold tracking-tighter leading-[1.04] mb-4 text-balance">
      Stop hand-writing <span class="bg-gradient-to-r from-accent via-accent-light to-accent bg-clip-text text-transparent">AsyncAPI YAML</span>.
    </h1>

    <p class="text-base sm:text-lg text-text-secondary max-w-2xl mx-auto mb-4 leading-relaxed text-pretty">
      Model your event schemas, channels, and operations in TypeSpec &mdash; compile to AsyncAPI 3.1 documents that validate against the official JSON Schema.
    </p>

    <p class="text-xs font-mono text-text-muted max-w-3xl mx-auto mb-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
      {statLine.map((item, index) => (
        <Fragment>
          {index > 0 && <span aria-hidden="true" class="text-border-hover">&middot;</span>}
          <span>{item}</span>
        </Fragment>
      ))}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-3">
      <a href="/getting-started/quick-start/" data-astro-prefetch class="px-6 py-3 bg-accent text-on-accent font-semibold rounded-lg text-base hover:bg-accent-hover transition-colors duration-150 inline-flex items-center gap-2 border-none cursor-pointer">Start in 5 minutes &rarr;</a>
      <a href="#playground" class="px-6 py-3 border border-border rounded-lg text-base font-semibold text-text-secondary hover:text-text-primary hover:border-border-hover transition-all duration-150 inline-flex items-center gap-2">Try it in your browser</a>
    </div>

    <div class="flex items-center justify-center gap-2 mb-6 text-sm">
      <code class="font-mono text-text-muted">{installCommand}</code>
      <button type="button" data-copy={installCommand} class="bg-transparent border border-border rounded-md text-text-muted px-2 py-1 cursor-pointer text-xs font-mono hover:text-text-primary hover:border-border-hover transition-all duration-150" aria-label="Copy install command">Copy</button>
    </div>

    <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-stretch text-left">
      <div class="rounded-xl border border-border bg-bg-code shadow-xl overflow-hidden code-preview">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-border">
          {Array(3).fill(null).map(() => (
            <span class="w-2.5 h-2.5 rounded-full bg-code-dot"></span>
          ))}
          <span class="ml-3 text-xs text-text-muted font-mono">api.tsp &mdash; what you write</span>
          <button type="button" data-copy-target="hero-tsp" class="ml-auto text-xs font-mono text-text-muted hover:text-text-primary border border-border rounded px-2 py-0.5 transition-colors" aria-label="Copy TypeSpec input">Copy</button>
        </div>
        <pre tabindex="0" class="p-4 text-[0.78rem] leading-6 font-mono overflow-x-auto"><code id="hero-tsp" set:html={inputCode} /></pre>
      </div>

      <div class="flex md:flex-col items-center justify-center gap-1 py-1 md:py-0 text-accent">
        <span class="text-xl md:text-2xl" aria-hidden="true"><span class="md:hidden">&darr;</span><span class="hidden md:inline">&rarr;</span></span>
        <span class="text-[0.7rem] font-mono text-text-muted whitespace-nowrap">tsp compile .</span>
      </div>

      <div class="rounded-xl border border-border bg-bg-code shadow-xl overflow-hidden code-preview">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-border">
          {Array(3).fill(null).map(() => (
            <span class="w-2.5 h-2.5 rounded-full bg-code-dot"></span>
          ))}
          <span class="ml-3 text-xs text-text-muted font-mono">asyncapi.yaml &mdash; what you ship</span>
          <span class="ml-auto inline-flex items-center gap-1 text-[0.7rem] font-mono text-success"><Icon name="check" size={12} />valid</span>
          <button type="button" data-copy-target="hero-yaml" class="ml-2 text-xs font-mono text-text-muted hover:text-text-primary border border-border rounded px-2 py-0.5 transition-colors" aria-label="Copy emitted AsyncAPI output">Copy</button>
        </div>
        <pre tabindex="0" class="p-4 text-[0.78rem] leading-6 font-mono overflow-x-auto"><code id="hero-yaml" set:html={outputCode} /></pre>
      </div>
    </div>

    <p class="mt-3 text-xs text-text-muted">
      Real output, not a mockup &mdash; abridged. Every document is checked against the official AsyncAPI 3.1.0 JSON Schema.
    </p>
  </div>
</section>

<script is:inline src="/js/copy-code.js"></script>
