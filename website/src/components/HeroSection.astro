---
import { siteConfig } from '../data/config';
import { heroCode } from '../data/hero-code';
import Icon from './Icon.astro';

async function getGitHubStars(): Promise<number | null> {
  try {
    const response = await fetch('https://api.github.com/repos/LarsArtmann/typespec-asyncapi', {
      headers: {
        'Accept': 'application/vnd.github.v3+json',
      },
    });
    if (!response.ok) return null;
    const data = await response.json();
    return data.stargazers_count as number;
  } catch {
    return null;
  }
}

const stars = await getGitHubStars();
const starsText = stars !== null ? `${stars} Stars` : 'Star on GitHub';

const highlightedCode = `<span class="text-[#bd93f9]">import</span> <span class="text-[#f1fa8c]">"@lars-artmann/typespec-asyncapi"</span>;
<span class="text-[#bd93f9]">using</span> <span class="text-[#8be9fd]">TypeSpec.AsyncAPI</span>;

<span class="text-[#bd93f9]">namespace</span> <span class="text-text-secondary">MyAPI</span>;

<span class="text-[#ff79c6]">model</span> <span class="text-[#8be9fd]">Event</span> {
  id: <span class="text-[#8be9fd]">string</span>;
  timestamp: <span class="text-[#8be9fd]">utcDateTime</span>;
}

<span class="text-[#ff79c6]">@channel</span>(<span class="text-[#f1fa8c]">"events"</span>)
<span class="text-[#ff79c6]">op</span> <span class="text-[#50fa7b]">publishEvent</span>(): <span class="text-[#8be9fd]">Event</span>;`;
---

<section class="relative flex items-center justify-center overflow-hidden pt-36 pb-20">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-accent/8 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 -left-20 w-[420px] h-[420px] bg-accent/8 blur-[130px] rounded-full pointer-events-none"></div>
  <div class="relative max-w-4xl xl:max-w-6xl mx-auto px-6 text-center">
    <div class="flex items-center justify-center gap-3 mb-7 flex-wrap">
      <a class="inline-flex items-center gap-1.5 px-3.5 py-1.5 border border-border rounded-md text-text-secondary text-sm font-medium no-underline hover:border-accent hover:text-accent transition-all duration-150" href={siteConfig.github} target="_blank" rel="noopener">
        <Icon name="star" size={14} />
        {starsText}
      </a>
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-accent text-sm font-medium bg-accent/10">
        <Icon name="check" size={14} />
        AsyncAPI 3.1.0 &middot; AJV-validated
      </span>
    </div>
    <h1 class="text-[clamp(2.5rem,7vw,4.5rem)] font-bold tracking-tighter leading-[1.05] mb-6">
      Stop hand-writing <span class="bg-gradient-to-r from-accent via-accent-light to-accent bg-clip-text text-transparent">AsyncAPI YAML</span>.
    </h1>

    <p class="text-[clamp(1.125rem,2.5vw,1.35rem)] text-text-secondary max-w-3xl mx-auto mb-4 leading-relaxed">
      Model your event schemas, channels, and operations in TypeSpec &mdash; compile to AsyncAPI 3.1 specifications that validate against the official JSON Schema, for 22 protocols.
    </p>

    <p class="text-sm text-text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
      One typed source of truth for Kafka, MQTT, AMQP, WebSocket, and 18 more &mdash; with 30 decorators, spec-generated protocol bindings, and a 270+-test compliance suite.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="/getting-started/installation/" data-astro-prefetch class="px-6 py-3 bg-accent text-on-accent font-semibold rounded-lg text-base hover:bg-accent-hover transition-colors duration-150 inline-flex items-center gap-2 border-none cursor-pointer">Get Started &rarr;</a>
      <div class="flex items-center gap-2 py-2.5 px-4 rounded-lg bg-bg-card-solid border border-border font-mono text-sm text-text-primary select-all">pnpm add @lars-artmann/typespec-asyncapi</div>
    </div>

    <div class="relative max-w-xl mx-auto">
      <div class="absolute -inset-4 bg-gradient-to-r from-accent/10 via-accent/8 to-accent/10 rounded-2xl blur-6 pointer-events-none"></div>
      <div class="relative rounded-xl border border-border bg-bg-code shadow-2xl overflow-hidden code-preview">
        <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border">
          {Array(3).fill(null).map(() => (
            <span class="w-3 h-3 rounded-full bg-code-dot"></span>
          ))}
          <span class="ml-3 text-xs text-text-muted font-mono">api.tsp</span>
        </div>
        <pre class="p-4 text-left text-sm font-mono leading-relaxed overflow-x-auto relative"><code id="hero-code" set:html={highlightedCode} /></pre>
        <button class="absolute top-2 right-2 bg-code-inline-bg/80 border border-border rounded-md text-text-muted px-1.5 py-1.5 cursor-pointer text-xs font-mono hover:text-text-primary hover:border-border-hover transition-all duration-150 opacity-0 [.code-preview:hover_&]:opacity-100" id="copy-btn" data-code={heroCode} aria-label="Copy code to clipboard">Copy</button>
      </div>
    </div>
  </div>
</section>

<script is:inline src="/js/copy-code.js"></script>
