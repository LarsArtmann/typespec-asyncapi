---
import LandingLayout from '../layouts/LandingLayout.astro';
import { siteConfig } from '../data/config';
---

<LandingLayout title="Page not found — typespec-asyncapi" canonicalPath="/404/" robots="noindex, follow">
  <section class="pt-40 pb-24">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <p class="text-xs font-semibold tracking-[0.2em] text-accent uppercase mb-4">404</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary mb-4">That page moved or never existed.</h1>
      <p class="text-text-muted mb-10">The documentation is small enough to find things by hand, or you can search it.</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
        <a href="/search/" class="px-6 py-3 bg-accent text-on-accent font-semibold rounded-lg hover:bg-accent-hover transition-colors">Search the docs</a>
        <a href="/getting-started/quick-start/" class="px-6 py-3 border border-border rounded-lg font-semibold text-text-secondary hover:text-text-primary hover:border-border-hover transition-all">Quick Start</a>
      </div>

      <nav aria-label="Popular documentation" class="grid gap-3 sm:grid-cols-2 text-left">
        <a href="/getting-started/installation/" class="rounded-xl border border-border bg-bg-card p-4 hover:border-border-hover transition-colors">
          <span class="block font-semibold text-text-primary">Installation</span>
          <span class="block text-sm text-text-muted">Wire the emitter into a TypeSpec project.</span>
        </a>
        <a href="/guides/decorators/" class="rounded-xl border border-border bg-bg-card p-4 hover:border-border-hover transition-colors">
          <span class="block font-semibold text-text-primary">Decorators</span>
          <span class="block text-sm text-text-muted">All 30 decorators, targets, and examples.</span>
        </a>
        <a href="/examples/" class="rounded-xl border border-border bg-bg-card p-4 hover:border-border-hover transition-colors">
          <span class="block font-semibold text-text-primary">Examples</span>
          <span class="block text-sm text-text-muted">Runnable Kafka, MQTT, and WebSocket specs.</span>
        </a>
        <a href={siteConfig.github} class="rounded-xl border border-border bg-bg-card p-4 hover:border-border-hover transition-colors">
          <span class="block font-semibold text-text-primary">GitHub</span>
          <span class="block text-sm text-text-muted">Source, issues, and releases.</span>
        </a>
      </nav>
    </div>
  </section>
</LandingLayout>
